{
  "name": "@doc-capture/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm assets && vite",
    "dev:https": "pnpm assets && vite --mode https --host",
    "build": "pnpm assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/copy-opencv.mjs && node scripts/copy-tesseract.mjs"
  },
  "dependencies": {
    "@doc-capture/core": "workspace:*",
    "@doc-capture/ocr-types": "workspace:*",
    "@doc-capture/opencv-build": "workspace:*",
    "@doc-capture/react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  }
}
