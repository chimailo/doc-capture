{
  "name": "doc-capture-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"!@doc-capture/opencv-build\" build",
    "build:opencv": "pnpm --filter @doc-capture/opencv-build build",
    "build:opencv:stock": "pnpm --filter @doc-capture/opencv-build build:stock",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "api": "pnpm -r --filter \"./packages/**\" --filter \"!@doc-capture/opencv-build\" api",
    "size": "size-limit",
    "bench": "pnpm --filter @doc-capture/bench bench",
    "changeset": "changeset",
    "api:check": "pnpm -r --filter \"./packages/**\" --filter \"!@doc-capture/opencv-build\" api:check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.59.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
