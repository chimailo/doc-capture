[
  {
    "name": "core + react (main thread, gzip)",
    "path": [
      "packages/core/dist/index.js",
      "packages/react/dist/index.js"
    ],
    "ignore": [
      "react",
      "react-dom",
      "react/jsx-runtime"
    ],
    "limit": "60 KB",
    "gzip": true
  },
  {
    "name": "core worker (gzip)",
    "path": "packages/core/dist/worker.js",
    "limit": "60 KB",
    "gzip": true
  }
]
