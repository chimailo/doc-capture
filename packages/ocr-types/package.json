{
  "name": "@doc-capture/ocr-types",
  "version": "0.0.0",
  "description": "OCR plugin interface for @doc-capture/core. Types only, no OCR code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "keywords": [
    "ocr",
    "plugin",
    "types"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
